# ============================================================
# DocuMind AI - Git ignore rules
# Python / FastAPI backend, future UI, Docker, local secrets
# ============================================================

# --- Environment variables and secrets ---
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
*.pem
*.key
*.p12
*.pfx

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pyright/
.ruff_cache/
.ipynb_checkpoints/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python packaging / build output ---
build/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
share/python-wheels/
lib/
lib64/
*.egg
*.egg-info/
.installed.cfg
pip-wheel-metadata/

# --- Logs and temporary files ---
*.log
logs/
*.tmp
*.bak

# --- Frontend (Node.js / React / Vite / Next.js) ---
node_modules/
.npm/
.parcel-cache/
.vite/
.next/
.nuxt/
.output/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Local uploads and generated application data ---
# Keep user-uploaded files and generated data out of Git.
uploads/
storage/
data/local/

# --- Docker local overrides ---
# Remove this rule if you intentionally want to version this file.
docker-compose.override.yml

# --- Editors and IDEs ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp

# --- Operating system files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Local test / tooling artifacts ---
.pytest_cache/
.hypothesis/
.cache/
